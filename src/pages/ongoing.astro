---
import Layout from '../layouts/Layout.astro';
import { getAllOngoingAnimes } from '../lib/db';

let animes = [];
let fetchError = false;

try {
  animes = await getAllOngoingAnimes(50);
} catch (err) {
  fetchError = true;
  console.error('DB error:', err);
}
---

<Layout title="MySite — ყველა მიმდინარე ანიმე">
  <section id="ongoing-panel">
    <a href="/" class="panel-title-btn">← მთავარ გვერდზე დაბრუნება</a>
    <h1 class="page-heading">მიმდინარე ანიმეები</h1>

    {fetchError && (
      <div class="error-message" style="display:block;">
        დაფიქსირდა შეცდომა მონაცემთა ბაზის წაკითხვისას.
      </div>
    )}

    <div class="anime-grid-full" id="anime-grid">
      {animes.map((item) => (
        <div class="anime-card" data-anime-id={item.id} data-title={(item.name || '').toLowerCase()}>
          {item.poster_url
            ? <img src={item.poster_url} alt={`${item.english_name || item.name} Cover`} class="anime-poster" loading="lazy" />
            : <div class="no-poster">No Image</div>
          }
          <div class="anime-info">
            <div class="anime-title">{item.english_name || item.name}</div>
            <div class="anime-meta">{item.studios || item.premiered || ''}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-heading {
    color: #ff3b3b;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .anime-grid-full {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px;
    padding-bottom: 40px;
  }
  .no-poster {
    width: 100%;
    height: 230px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8a9ba8;
    font-size: 12px;
  }
</style>

<script>
  const searchInput = document.getElementById('search-input');

  function debounce(fn, delay) {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  function handleSearch(e) {
    const term = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.anime-card').forEach(card => {
      const title = card.dataset.title || '';
      card.style.display = !term || title.includes(term) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', debounce(handleSearch, 300));
</script>
