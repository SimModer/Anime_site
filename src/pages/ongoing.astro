---
// src/pages/ongoing.astro
// Full ongoing animes page — loads from SQLite database at build time.
import Layout from '../layouts/Layout.astro';
import { getAllOngoingAnimes } from '../lib/db';

let animes = [];
let fetchError = false;

try {
  animes = getAllOngoingAnimes(50);
} catch (err) {
  fetchError = true;
  console.error('DB error:', err);
}
---

<Layout title="MySite — ყველა მიმდინარე ანიმე">
  <section id="ongoing-panel">
    <a href="/" class="panel-title-btn">← მთავარ გვერდზე დაბრუნება</a>
    <h1 class="page-heading">მიმდინარე ანიმეები</h1>

    {fetchError && (
      <div class="error-message" style="display:block;">
        დაფიქსირდა შეცდომა მონაცემთა ბაზის წაკითხვისას.
      </div>
    )}

    <div class="anime-grid-full" id="anime-grid">
      {animes.map((anime) => (
        <div class="anime-card" data-anime-id={anime.id} data-title={anime.title.toLowerCase()}>
          <img src={anime.cover} alt={`${anime.title} Cover`} class="anime-poster" loading="lazy" />
          <div class="anime-info">
            <div class="anime-title">{anime.title}</div>
            <div class="anime-meta">{anime.studio}</div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-heading {
    color: #ff3b3b;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 20px;
  }

  .anime-grid-full {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px;
    padding-bottom: 40px;
  }
</style>

<script>
  const searchInput = document.getElementById('search-input');

  function debounce(fn, delay) {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  function handleSearch(e) {
    const term = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.anime-card').forEach(card => {
      const title = card.dataset.title || '';
      card.style.display = !term || title.includes(term) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', debounce(handleSearch, 300));
</script>
