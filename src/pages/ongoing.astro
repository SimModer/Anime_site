---
// src/pages/ongoing.astro
// Full ongoing animes page
import Layout from '../layouts/Layout.astro';

const ITEMS_PER_PAGE = 50;

const query = `
  query {
    Page(perPage: ${ITEMS_PER_PAGE}) {
      media(status: RELEASING, type: ANIME, sort: POPULARITY_DESC) {
        id
        title {
          romaji
          english
        }
        coverImage {
          large
          medium
        }
        studios(isMain: true) {
          nodes {
            name
          }
        }
      }
    }
  }
`;

let animes = [];
let fetchError = false;

try {
  const res = await fetch('https://graphql.anilist.co', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json',
    },
    body: JSON.stringify({ query }),
  });

  if (!res.ok) throw new Error(`HTTP error: ${res.status}`);
  const json = await res.json();
  animes = json?.data?.Page?.media ?? [];
} catch (err) {
  fetchError = true;
  console.error('Anilist fetch error:', err);
}
---

<Layout title="MySite — ყველა მიმდინარე ანიმე">
  <section id="ongoing-panel">
    <h1 class="panel-title-btn" style="cursor:default;">მიმდინარე ანიმეები</h1>

    {fetchError && (
      <div class="error-message" style="display:block;">
        დაფიქსირდა შეცდომა. სცადეთ მოგვიანებით.
      </div>
    )}

    <div class="anime-grid-full" id="anime-grid">
      {animes.map((anime) => {
        const title = anime.title?.romaji || anime.title?.english || 'უსახელო';
        const cover = anime.coverImage?.large || anime.coverImage?.medium || '';
        const studio = anime.studios?.nodes?.[0]?.name || 'სტუდია უცნობია';

        return (
          <div class="anime-card" data-anime-id={anime.id} data-title={title.toLowerCase()}>
            <img src={cover} alt={`${title} Cover`} class="anime-poster" loading="lazy" />
            <div class="anime-info">
              <div class="anime-title">{title}</div>
              <div class="anime-meta">{studio}</div>
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Layout>

<style>
  .anime-grid-full {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 20px;
    padding-bottom: 40px;
  }
</style>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;

  function debounce(fn: (...args: any[]) => void, delay: number) {
    let timer: ReturnType<typeof setTimeout>;
    return (...args: any[]) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  function handleSearch(e: Event) {
    const term = (e.target as HTMLInputElement).value.toLowerCase().trim();
    document.querySelectorAll<HTMLElement>('.anime-card').forEach(card => {
      const title = card.dataset.title || '';
      card.style.display = !term || title.includes(term) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', debounce(handleSearch, 300));
</script>
