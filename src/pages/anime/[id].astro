---
// src/pages/anime/[id].astro
import type { GetStaticPaths } from 'astro';
import { getAnimeById, getAllOngoingAnimes } from '../../lib/db';
import type { MediaItem } from '../../lib/db';

export const getStaticPaths: GetStaticPaths = async () => {
  // Pre-render only ongoing anime at build time.
  // Add more queries here if you want to pre-render everything.
  const items = await getAllOngoingAnimes();
  return items.map((item) => ({
    params: { id: String(item.id) },
  }));
};

const { id } = Astro.params;
const anime: MediaItem | null = await getAnimeById(Number(id));

if (!anime) {
  return Astro.redirect('/404');
}

// ── Helpers ──────────────────────────────────────────────────
const displayTitle  = anime.english_name || anime.name;
const genres        = anime.genres
  ? anime.genres.split(',').map((g) => g.trim()).slice(0, 8)
  : [];
const statusLabel   = anime.status ? anime.status.charAt(0).toUpperCase() + anime.status.slice(1).toLowerCase() : '—';
const episodeInfo   = anime.episodes
  ? anime.episodes_aired
    ? `${anime.episodes_aired} / ${anime.episodes}`
    : String(anime.episodes)
  : '—';
---

<!DOCTYPE html>
<html lang="ka">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{displayTitle} - MySite</title>
  <style>
    :root {
      --primary:#4ecdc4; --primary-alt:#45b7d1; --accent:#ff6b6b;
      --bg-gradient:linear-gradient(135deg,#1a1a2e,#16213e);
      --glass-bg:rgba(0,0,0,0.3); --glass-bg-light:rgba(0,0,0,0.4);
      --glass-border:rgba(78,205,196,0.2); --text-muted:#8a9ba8; --text-light:#fff;
      --white-soft:rgba(255,255,255,0.05); --white-hover:rgba(255,255,255,0.08);
      --transition:all 0.3s ease; --radius-md:15px; --radius-sm:10px;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{background:var(--bg-gradient);color:var(--text-light);font-family:'Segoe UI',sans-serif;min-height:100vh;line-height:1.6;}

    header{background:var(--glass-bg-light);backdrop-filter:blur(10px);padding:20px 0;position:sticky;top:0;z-index:100;border-bottom:1px solid var(--glass-border);}
    .header-container{max-width:1400px;margin:0 auto;padding:0 30px;display:flex;justify-content:center;}
    .logo{font-size:28px;font-weight:bold;color:var(--primary);text-shadow:2px 2px 4px rgba(0,0,0,.5);text-decoration:none;}

    .container{max-width:1400px;margin:0 auto;padding:40px 30px;}
    .main-content{display:grid;grid-template-columns:300px 1fr;gap:30px;}

    /* Sidebar */
    .sidebar{display:flex;flex-direction:column;gap:20px;}
    .anime-poster{background:var(--glass-bg);border-radius:15px;padding:20px;border:1px solid var(--glass-border);}
    .poster-image{width:100%;aspect-ratio:3/4;border-radius:var(--radius-md);object-fit:cover;box-shadow:0 10px 30px rgba(0,0,0,.3);background:var(--glass-bg-light);}
    .poster-placeholder{width:100%;aspect-ratio:3/4;border-radius:var(--radius-md);background:var(--glass-bg-light);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:13px;}

    .user-actions{background:var(--glass-bg);border-radius:15px;padding:20px;border:1px solid var(--glass-border);}
    .rating-section{margin-bottom:20px;}
    .score-display{display:flex;align-items:center;gap:10px;margin-bottom:15px;}
    .score-value{font-size:24px;font-weight:bold;color:var(--primary);}
    .score-max{color:var(--text-muted);}
    .stars{display:flex;gap:5px;}
    .star{color:var(--text-muted);cursor:pointer;transition:var(--transition);font-size:20px;}
    .star.active,.star:hover{color:#ffd700;}
    .dropdown{position:relative;width:100%;}
    .dropdown-btn{background:linear-gradient(45deg,var(--primary),var(--primary-alt));color:var(--text-light);padding:12px 16px;border:none;border-radius:var(--radius-sm);width:100%;cursor:pointer;font-size:14px;font-weight:bold;display:flex;justify-content:space-between;align-items:center;transition:var(--transition);}
    .dropdown-menu{display:none;position:absolute;top:105%;left:0;width:100%;background:var(--glass-bg);backdrop-filter:blur(10px);border-radius:var(--radius-sm);border:1px solid var(--glass-border);z-index:10;overflow:hidden;}
    .dropdown-menu.show{display:block;animation:fadeInUp 0.25s ease;}
    .dropdown-menu a{display:block;padding:12px 16px;text-decoration:none;color:var(--text-light);transition:var(--transition);border-bottom:1px solid var(--glass-border);}
    .dropdown-menu a:last-child{border-bottom:none;}
    .dropdown-menu a:hover{background:var(--white-hover);color:var(--primary);}

    /* Main content */
    .content-area{display:flex;flex-direction:column;gap:25px;}
    .anime-header{background:var(--glass-bg);border-radius:20px;padding:30px;border:1px solid var(--glass-border);}
    .title-section{margin-bottom:20px;}
    .anime-title{font-size:32px;font-weight:bold;color:var(--primary);text-shadow:2px 2px 4px rgba(0,0,0,.3);margin-bottom:8px;}
    .title-alternative{font-size:16px;color:var(--text-muted);margin-bottom:4px;}
    .title-actions{display:flex;gap:10px;align-items:center;margin-top:14px;}
    .edit-btn{background:var(--glass-bg);border:1px solid var(--glass-border);color:var(--primary);padding:8px 14px;border-radius:var(--radius-sm);display:inline-flex;align-items:center;gap:7px;transition:var(--transition);text-decoration:none;font-size:13px;font-weight:600;}
    .edit-btn:hover{background:rgba(78,205,196,0.15);transform:scale(1.04);box-shadow:0 0 0 2px rgba(78,205,196,0.3);}

    .anime-meta-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:15px;}
    .meta-item{background:var(--white-soft);padding:12px 16px;border-radius:var(--radius-sm);border-left:4px solid var(--primary);}
    .meta-label{color:var(--primary);font-weight:bold;margin-right:8px;}
    .meta-value{color:var(--text-light);}
    .meta-value.muted{color:var(--text-muted);}

    /* Genre pills */
    .genre-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;}
    .genre-pill{background:rgba(78,205,196,0.1);border:1px solid rgba(78,205,196,0.25);color:var(--primary);padding:4px 12px;border-radius:20px;font-size:12px;text-transform:capitalize;}

    /* Tabs */
    .content-tabs{background:var(--glass-bg);border-radius:20px;border:1px solid var(--glass-border);overflow:hidden;}
    .tab-nav{display:flex;background:var(--glass-bg-light);border-bottom:1px solid var(--glass-border);}
    .tab-btn{padding:15px 25px;background:none;border:none;color:var(--text-muted);cursor:pointer;transition:var(--transition);font-size:15px;font-weight:500;flex:1;}
    .tab-btn.active{background:var(--primary);color:var(--text-light);}
    .tab-btn:hover:not(.active){background:var(--white-hover);color:var(--text-light);}
    .tab-content{padding:30px;display:none;}
    .tab-content.active{display:block;}
    .description-text{font-size:15px;line-height:1.9;color:var(--text-light);white-space:pre-line;}
    .no-data{color:var(--text-muted);font-style:italic;font-size:14px;}

    /* Comments */
    .comments-section{background:var(--glass-bg);border-radius:20px;padding:30px;border:1px solid var(--glass-border);}
    .comments-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;border-bottom:2px solid var(--glass-border);padding-bottom:15px;}
    .comments-header h2{font-size:22px;color:var(--primary);}
    .comments-stats{color:var(--text-muted);font-size:14px;}
    #comment-input{width:100%;min-height:90px;background:var(--glass-bg-light);border:1px solid var(--glass-border);border-radius:var(--radius-sm);padding:14px;color:var(--text-light);font-family:inherit;font-size:14px;resize:vertical;transition:var(--transition);outline:none;}
    #comment-input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(78,205,196,.1);}
    #comment-input::placeholder{color:var(--text-muted);}
    .submit-btn{background:linear-gradient(45deg,var(--primary),var(--primary-alt));color:#fff;padding:11px 22px;border:none;border-radius:var(--radius-sm);cursor:pointer;font-weight:bold;transition:var(--transition);margin-top:12px;font-family:inherit;}
    .submit-btn:hover{transform:translateY(-2px);box-shadow:0 5px 15px rgba(78,205,196,.4);}
    .comments-list{display:flex;flex-direction:column;gap:18px;margin-top:24px;}
    .comment-item{display:flex;gap:14px;background:var(--white-soft);padding:18px;border-radius:var(--radius-md);transition:var(--transition);}
    .comment-item:hover{background:var(--white-hover);}
    .comment-avatar{width:38px;height:38px;border-radius:50%;background:var(--glass-bg-light);border:2px solid var(--primary);display:flex;align-items:center;justify-content:center;flex-shrink:0;font-weight:bold;color:var(--primary);font-size:14px;}
    .comment-author{font-weight:bold;color:var(--primary);font-size:14px;}
    .comment-date{color:var(--text-muted);font-size:11px;margin-left:10px;}
    .comment-text{color:var(--text-light);line-height:1.6;margin-top:6px;font-size:14px;}

    @keyframes fadeInUp{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}
    @media(max-width:1024px){.main-content{grid-template-columns:1fr;}.sidebar{order:2;}.content-area{order:1;}}
    @media(max-width:768px){.container{padding:20px;}.anime-meta-grid{grid-template-columns:1fr;}.tab-nav{flex-direction:column;}.anime-title{font-size:22px;}}
  </style>
</head>
<body>
  <header>
    <div class="header-container">
      <a href="/" class="logo">MySite</a>
    </div>
  </header>

  <main class="container">
    <div class="main-content">

      <!-- Sidebar -->
      <aside class="sidebar">
        <div class="anime-poster">
          {anime.poster_url
            ? <img src={anime.poster_url} alt={displayTitle} class="poster-image"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
            : null
          }
          <div class="poster-placeholder" style={anime.poster_url ? 'display:none' : ''}>
            სურათი არ არის
          </div>
        </div>

        <div class="user-actions">
          <div class="rating-section">
            <h4 style="color:var(--primary);margin-bottom:15px;">შეფასება</h4>
            <div class="score-display">
              <span class="score-value" id="score-val">0</span>
              <span class="score-max">/ 10</span>
            </div>
            <div class="stars" id="rating-stars">
              <span class="star">★</span><span class="star">★</span>
              <span class="star">★</span><span class="star">★</span>
              <span class="star">★</span>
            </div>
          </div>
          <div style="margin-top:15px;">
            <div class="dropdown">
              <button class="dropdown-btn" id="dd-btn">სიაში დამატება <span>▼</span></button>
              <div class="dropdown-menu" id="dd-menu">
                <a href="#" data-s="watching">ვუყურებ</a>
                <a href="#" data-s="plan">ვაპირებ ყურებას</a>
                <a href="#" data-s="completed">დასრულებული</a>
                <a href="#" data-s="dropped">მივატოვე</a>
                <a href="#" data-s="hold">შეჩერებული</a>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Content -->
      <div class="content-area">

        <section class="anime-header">
          <div class="title-section">
            <h1 class="anime-title">{displayTitle}</h1>
            {anime.japanese_name && <div class="title-alternative">{anime.japanese_name}</div>}
            {anime.name !== displayTitle && <div class="title-alternative">{anime.name}</div>}
            {anime.other_name && <div class="title-alternative">{anime.other_name}</div>}
            <div class="title-actions">
              <a href={`/anime/${anime.id}/edit`} class="edit-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                  <path d="m18.5 2.5 a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"/>
                </svg>
                რედაქტირება
              </a>
            </div>
          </div>

          <div class="anime-meta-grid">
            <div class="meta-item">
              <span class="meta-label">ტიპი:</span>
              <span class="meta-value">{anime.type || '—'}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">ეპიზოდები:</span>
              <span class="meta-value">{episodeInfo}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">სტატუსი:</span>
              <span class="meta-value">{statusLabel}</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">გამოშვება:</span>
              <span class={`meta-value${!anime.aired_on && !anime.premiered ? ' muted' : ''}`}>
                {anime.aired_on || anime.premiered || '—'}
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">სეზონი:</span>
              <span class={`meta-value${!anime.premiered ? ' muted' : ''}`}>
                {anime.premiered || '—'}
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">სტუდია:</span>
              <span class={`meta-value${!anime.studios ? ' muted' : ''}`}>
                {anime.studios || '—'}
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">წყარო:</span>
              <span class={`meta-value${!anime.source ? ' muted' : ''}`}>
                {anime.source || '—'}
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">ხანგრძლივობა:</span>
              <span class={`meta-value${!anime.duration ? ' muted' : ''}`}>
                {anime.duration || '—'}
              </span>
            </div>
            <div class="meta-item">
              <span class="meta-label">რეიტინგი:</span>
              <span class={`meta-value${!anime.rating ? ' muted' : ''}`}>
                {anime.rating || '—'}
              </span>
            </div>
            {(anime.volumes || anime.chapters) && (
              <div class="meta-item">
                <span class="meta-label">ტომი / თავი:</span>
                <span class="meta-value">
                  {anime.volumes ?? '—'} / {anime.chapters ?? '—'}
                </span>
              </div>
            )}
          </div>

          {genres.length > 0 && (
            <div class="genre-pills">
              {genres.map((g) => <span class="genre-pill">{g}</span>)}
            </div>
          )}
        </section>

        <!-- Tabs -->
        <section class="content-tabs">
          <nav class="tab-nav">
            <button class="tab-btn active" data-tab="synopsis">სინოფსისი</button>
            <button class="tab-btn" data-tab="details">დეტალები</button>
          </nav>

          <div class="tab-content active" id="synopsis-tab">
            {anime.synopsis
              ? <p class="description-text">{anime.synopsis}</p>
              : <p class="no-data">აღწერა არ არის.</p>
            }
          </div>

          <div class="tab-content" id="details-tab">
            <div style="display:flex;flex-direction:column;gap:12px;">
              {anime.producers && (
                <div class="meta-item">
                  <span class="meta-label">პროდიუსერები:</span>
                  <span class="meta-value">{anime.producers}</span>
                </div>
              )}
              {anime.licensors && (
                <div class="meta-item">
                  <span class="meta-label">ლიცენზიარები:</span>
                  <span class="meta-value">{anime.licensors}</span>
                </div>
              )}
              {anime.russian && (
                <div class="meta-item">
                  <span class="meta-label">რუსული სახელი:</span>
                  <span class="meta-value">{anime.russian}</span>
                </div>
              )}
              {anime.released_on && (
                <div class="meta-item">
                  <span class="meta-label">გამოშვების თარიღი:</span>
                  <span class="meta-value">{anime.released_on}</span>
                </div>
              )}
              {!anime.producers && !anime.licensors && !anime.russian && !anime.released_on && (
                <p class="no-data">დამატებითი ინფორმაცია არ არის.</p>
              )}
            </div>
          </div>
        </section>

        <!-- Comments -->
        <section class="comments-section">
          <div class="comments-header">
            <h2>კომენტარები</h2>
            <span class="comments-stats" id="comment-count">0 კომენტარი</span>
          </div>
          <textarea id="comment-input" placeholder="დაწერეთ კომენტარი... (Ctrl+Enter გასაგზავნად)"></textarea>
          <button class="submit-btn" id="submit-comment">გაგზავნა</button>
          <div class="comments-list" id="comments-list"></div>
        </section>

      </div>
    </div>
  </main>

  <script>
    // Tabs
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(btn.dataset.tab + '-tab').classList.add('active');
      });
    });

    // Stars
    const stars = document.querySelectorAll('.star');
    const scoreVal = document.getElementById('score-val');
    let rating = 0;
    stars.forEach((s, i) => {
      s.addEventListener('click', () => { rating = i + 1; updateStars(); scoreVal.textContent = String(rating * 2); });
      s.addEventListener('mouseenter', () => stars.forEach((x, j) => x.classList.toggle('active', j <= i)));
    });
    document.getElementById('rating-stars').addEventListener('mouseleave', () => updateStars());
    function updateStars() { stars.forEach((s, i) => s.classList.toggle('active', i < rating)); }

    // Dropdown
    document.getElementById('dd-btn').addEventListener('click', e => {
      e.stopPropagation();
      document.getElementById('dd-menu').classList.toggle('show');
    });
    document.addEventListener('click', () => document.getElementById('dd-menu').classList.remove('show'));
    document.querySelectorAll('#dd-menu a').forEach(a => {
      a.addEventListener('click', e => {
        e.preventDefault();
        document.getElementById('dd-btn').innerHTML = (e.target as HTMLElement).textContent + ' <span>▼</span>';
        document.getElementById('dd-menu').classList.remove('show');
      });
    });

    // Comments
    let count = 0;
    function postComment() {
      const inp = document.getElementById('comment-input') as HTMLTextAreaElement;
      const text = inp.value.trim();
      if (!text) return;
      count++;
      document.getElementById('comment-count').textContent = count + ' კომენტარი';
      const div = document.createElement('div');
      div.className = 'comment-item';
      div.style.cssText = 'opacity:0;transform:translateY(-12px);transition:all 0.3s ease;';
      div.innerHTML = `
        <div class="comment-avatar">თქ</div>
        <div style="flex:1">
          <span class="comment-author">თქვენ</span>
          <span class="comment-date">ახლა</span>
          <div class="comment-text">${text.replace(/</g,'&lt;')}</div>
        </div>`;
      const list = document.getElementById('comments-list');
      list.insertBefore(div, list.firstChild);
      inp.value = '';
      requestAnimationFrame(() => { div.style.opacity = '1'; div.style.transform = 'translateY(0)'; });
    }
    document.getElementById('submit-comment').addEventListener('click', postComment);
    document.getElementById('comment-input').addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' && e.ctrlKey) postComment();
    });
  </script>
</body>
</html>
