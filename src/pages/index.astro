---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import { getOngoingAnimes } from '../lib/db';

let animes = [];
let fetchError = false;

try {
  animes = getOngoingAnimes(20);
} catch (err) {
  fetchError = true;
  console.error('DB error:', err);
}
---

<Layout title="MySite">

  {fetchError && (
    <div class="error-message" style="display:block;">
      დაფიქსირდა შეცდომა მონაცემთა ბაზის წაკითხვისას.
    </div>
  )}

  <!-- მიმდინარე ანიმეები -->
  <section id="ongoing-panel">
    <a href="/ongoing" class="panel-title-btn">მიმდინარე ანიმეები →</a>
    <div class="anime-strip" id="anime-grid">
      {animes.map((item) => (
        <div class="anime-card" data-anime-id={item.id} data-title={(item.name || '').toLowerCase()}>
          {item.poster_url
            ? <img src={item.poster_url} alt={`${item.name} Cover`} class="anime-poster" loading="lazy" />
            : <div class="no-poster">No Image</div>
          }
          <div class="anime-info">
            <div class="anime-title">{item.english_title || item.name}</div>
            <div class="anime-meta">{item.studios || item.premiered || ''}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- სიახლეები -->
  <section class="news-section">
    <h2 class="news-title">სიახლეები</h2>
  </section>

</Layout>

<style>
  .no-poster {
    width: 100%;
    height: 230px;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8a9ba8;
    font-size: 12px;
  }
</style>

<script>
  const searchInput = document.getElementById('search-input');

  function debounce(fn, delay) {
    let timer;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  function handleSearch(e) {
    const term = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.anime-card').forEach(card => {
      const title = card.dataset.title || '';
      card.style.display = !term || title.includes(term) ? '' : 'none';
    });
  }

  searchInput?.addEventListener('input', debounce(handleSearch, 300));
</script>